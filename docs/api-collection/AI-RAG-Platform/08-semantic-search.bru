meta {
  name: 11 Semantic Search
  type: http
  seq: 11
}

post {
  url: {{base_url}}/search
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "knowledge_base_id": "{{knowledge_base_id}}",
    "query": "Which databases does the platform use?",
    "limit": 5
  }
}
