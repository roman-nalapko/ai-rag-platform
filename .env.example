DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag
LOG_LEVEL=INFO
QDRANT_URL=http://localhost:6333
UPLOAD_STORAGE_PATH=storage/uploads
UPLOAD_MAX_BYTES=10485760
LM_STUDIO_BASE_URL=http://localhost:1234/v1
DOCKER_LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_CHAT_MODEL=distill-e4b-it-4-bit-mlx
LM_STUDIO_EMBEDDING_MODEL=nomic-ai/text-embedding-nomic-embed-text-v1.5
LM_STUDIO_TIMEOUT_SECONDS=300
LM_STUDIO_MAX_TOKENS=64
RERANKING_ENABLED=false
RERANKING_CANDIDATE_MULTIPLIER=3
JWT_SECRET_KEY=change-this-local-development-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
DOCUMENT_WORKER_ENABLED=true
DOCUMENT_WORKER_POLL_SECONDS=2
